{
  "id": "vectra-tool-wrapper",
  "name": "Vectra Tool Wrapper",
  "description": "Routes authorized tool execution through Vectra's ATP enforcement gateway.",
  "activation": { "onStartup": false, "onConfigPaths": ["plugins.entries.vectra-tool-wrapper"] },
  "contracts": {
    "tools": ["vectra_execute"],
    "trustedToolPolicies": ["vectra-only"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["allowedTools", "protectedAgentIds"],
    "properties": {
      "gatewayUrl": { "type": "string", "default": "http://127.0.0.1:18801", "description": "Loopback Vectra tool gateway URL." },
      "authTokenEnv": { "type": "string", "default": "VECTRA_TOOL_GATEWAY_TOKEN", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
      "allowedTools": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" } },
      "protectedAgentIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$" }, "description": "Canary agent IDs whose only executable tool is vectra_execute." },
      "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000, "default": 30000 },
      "maxRequestBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576, "default": 262144 },
      "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576, "default": 262144 }
    }
  }
}
