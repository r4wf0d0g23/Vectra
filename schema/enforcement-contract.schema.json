{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/r4wf0d0g23/Vectra/schema/enforcement-contract.schema.json",
  "title": "Vectra ATP Enforcement Envelope",
  "type": "object",
  "required": ["contract_version", "run_id", "bundle_id", "impact", "pins"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "bundle_id": { "type": "string", "minLength": 1 },
    "impact": { "enum": ["read-only", "state-changing"] },
    "pins": {
      "type": "object",
      "required": ["protocol", "variables", "bundleSha256", "pluginVersion", "contractVersion"],
      "properties": {
        "protocol": { "$ref": "#/$defs/pin" },
        "variables": { "type": "array", "items": { "$ref": "#/$defs/pin" } },
        "bundleSha256": { "$ref": "#/$defs/sha256" },
        "pluginVersion": { "type": "string", "minLength": 1 },
        "contractVersion": { "const": "1.0.0" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pin": {
      "type": "object",
      "required": ["id", "version", "schemaVersion", "contentSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "string", "minLength": 1 },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "validatorSha256": { "$ref": "#/$defs/sha256" },
        "attestationId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
