# Copy to /etc/vectra/proxy.env with mode 0600. Never commit populated values.
VECTRA_ATP_PATH=/etc/vectra/atp-instance
VECTRA_SNAPSHOT_PATH=/var/lib/vectra/snapshots
VECTRA_LEDGER_PATH=/var/lib/vectra/ledger
VECTRA_ARTIFACTS_PATH=/var/lib/vectra/artifacts
VECTRA_TELEMETRY_PATH=/var/lib/vectra/telemetry/events.jsonl
VECTRA_VALIDATOR_CONFIG=/etc/vectra/validator.json
VECTRA_UPSTREAM_URL=https://provider.invalid
VECTRA_UPSTREAM_TOKEN=REPLACE_FROM_SECRET_STORE
VECTRA_PROXY_TOKEN=REPLACE_WITH_32_BYTE_RANDOM_LOCAL_TOKEN
VECTRA_PROXY_PORT=18800
VECTRA_SHUTDOWN_GRACE_MS=15000
