[Unit]
Description=Vectra constrained validator daemon
After=local-fs.target
Before=vectra.service

[Service]
Type=simple
User=rawdata
Group=rawdata
UMask=0007
WorkingDirectory=/opt/vectra/current
Environment=NODE_ENV=production
Environment=VECTRA_VALIDATOR_CONFIG=/etc/vectra/validator.json
ExecStart=/usr/bin/node /opt/vectra/current/dist/src/validation/main.js
Restart=on-failure
RestartSec=3s
RuntimeDirectory=vectra-validator
RuntimeDirectoryMode=0750

# The daemon has no network listener and may only execute config-pinned adapters.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute is intentionally omitted: V8 requires executable JIT pages.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/run/vectra-validator

[Install]
WantedBy=multi-user.target
